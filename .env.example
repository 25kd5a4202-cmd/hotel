# Neon Database URLs (replace with your Neon branch URLs)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_BRANCH="production"

# Authentication Secret
AUTH_SECRET="your-super-secret-jwt-or-session-key-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Optional / Sandbox Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Restaurant Defaults
NEXT_PUBLIC_RESTAURANT_NAME="Antigravity Bistro & Kitchen"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"
