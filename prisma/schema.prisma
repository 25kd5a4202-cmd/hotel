datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
  ONLINE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  carts        Cart[]
  redemptions  CouponRedemption[]
  auditLogs    AuditLog[]

  @@index([email])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Home") // Home, Work, Other
  street     String
  landmark   String?
  city       String
  state      String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]

  @@index([slug])
  @@index([displayOrder])
}

model Product {
  id              String           @id @default(cuid())
  categoryId      String
  name            String
  slug            String           @unique
  description     String
  basePrice       Int              // in cents/paise (integer minor units)
  isVeg           Boolean          @default(true)
  image           String?
  isAvailable     Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  preparationTime Int              @default(20) // in minutes
  displayOrder    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  addOnGroups     AddOnGroup[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([isAvailable])
}

model ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  name          String     // "Regular", "Large", "Half", "Full"
  priceModifier Int        @default(0) // price difference in minor units from basePrice
  isDefault     Boolean    @default(false)
  isAvailable   Boolean    @default(true)

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]

  @@index([productId])
}

model AddOnGroup {
  id          String        @id @default(cuid())
  productId   String
  name        String        // "Choose Sauce", "Extra Cheese"
  minSelect   Int           @default(0)
  maxSelect   Int           @default(1)
  isRequired  Boolean       @default(false)

  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     AddOnOption[]

  @@index([productId])
}

model AddOnOption {
  id          String     @id @default(cuid())
  groupId     String
  name        String
  price       Int        @default(0) // in minor units
  isAvailable Boolean    @default(true)

  group       AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  sessionToken String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id              String          @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  selectedAddOns  String          @default("[]") // JSON string of selected add-on details
  quantity        Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique // e.g., "ORD-2026-98124"
  userId          String?
  customerName    String
  customerEmail   String
  customerPhone   String
  orderType       OrderType            @default(DELIVERY)
  deliveryAddress String?              // JSON snapshot of delivery address
  status          OrderStatus          @default(PENDING)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentMethod   PaymentMethod        @default(COD)
  subtotal        Int                  // in minor units
  discountTotal   Int                  @default(0)
  deliveryFee     Int                  @default(0)
  taxTotal        Int                  @default(0)
  grandTotal      Int                  // in minor units
  couponCode      String?
  notes           String?
  idempotencyKey  String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  redemptions     CouponRedemption[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  productName    String   // immutable snapshot
  variantName    String?  // immutable snapshot
  selectedAddOns String   @default("[]") // JSON string of add-on details snapshot
  unitPrice      Int      // immutable snapshot in minor units
  quantity       Int
  totalPrice     Int      // unitPrice * quantity in minor units

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?
  changedBy String?     // e.g. "Admin (email)" or "System"
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          PaymentMethod
  transactionId     String?       @unique
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  amount            Int           // in minor units
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  description     String?
  discountType    DiscountType       @default(PERCENTAGE)
  discountValue   Int                // percentage (e.g. 20) or fixed amount in minor units (e.g. 5000 = ₹50)
  minOrderAmount  Int                @default(0) // in minor units
  maxDiscount     Int?               // in minor units for percentage caps
  usageLimit      Int?               // null = unlimited
  usedCount       Int                @default(0)
  validFrom       DateTime           @default(now())
  validUntil      DateTime
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  redemptions     CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String
  userId     String?
  redeemedAt DateTime @default(now())

  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([orderId])
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  userId             String?
  userName           String
  rating             Int      @default(5) // 1-5
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([rating])
}

model RestaurantSettings {
  id                   String   @id @default("default")
  name                 String   @default("Antigravity Bistro & Kitchen")
  phone                String   @default("+91 98765 43210")
  email                String   @default("orders@antigravitybistro.com")
  address              String   @default("104 Food Street, Gourmet Lane, Tech Park")
  isOpen               Boolean  @default(true)
  deliveryRadiusKm     Float    @default(15.0)
  minOrderAmount       Int      @default(19900) // ₹199.00
  deliveryFee          Int      @default(4000)  // ₹40.00
  freeDeliveryThreshold Int     @default(50000) // ₹500.00
  taxPercentage        Float    @default(5.0)   // 5% GST
  openingHour          String   @default("10:00")
  closingHour          String   @default("23:00")
  currencySymbol       String   @default("₹")
  currencyCode         String   @default("INR")
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "UPDATE_ORDER_STATUS", "CREATE_PRODUCT"
  entityType String   // "ORDER", "PRODUCT", "SETTINGS"
  entityId   String?
  userId     String?
  details    String?  // JSON string
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([createdAt])
}
